<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Anibel.App.Reading.ReaderHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Anibel.App.Core" xmlns:views="using:Anibel.App.Views"
    RequestedTheme="Dark">
    <UserControl.Resources><views:StringToImageConverter x:Key="Img" /></UserControl.Resources>
    <Border x:Name="Chrome" Background="#111111">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid x:Name="ContentRoot" Background="#111111" Tapped="OnSurfaceTapped" SizeChanged="OnViewportChanged">
                <ScrollViewer x:Name="PagesScroll" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="3"
                    HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto" ViewChanged="OnScrollChanged">
                    <ItemsControl x:Name="PagesList" HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:ChapterImageDto">
                                <Image Stretch="Uniform" HorizontalAlignment="Stretch"
                                    Source="{Binding Large, Converter={StaticResource Img}, ConverterParameter=width:1600}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ScrollViewer x:Name="SingleScroll" Visibility="Collapsed" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="3"
                    HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" ViewChanged="OnScrollChanged">
                    <Image x:Name="SinglePage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ScrollViewer>
                <StackPanel x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="640" IsHitTestVisible="False">
                    <TextBlock x:Name="StatusText" Foreground="#99FFFFFF" TextAlignment="Center" TextWrapping="Wrap" />
                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40" Foreground="Gray" />
                </StackPanel>
                <Grid x:Name="ErrorHost" Visibility="Collapsed">
                    <views:EmptyState x:Name="ErrorState" Title="Прабачце!" Glyph="&#xE7BA;" ActionText="Абнавіць" SecondaryText="Капіяваць"
                        ActionClick="OnRetryErrorClick" SecondaryClick="OnCopyErrorClick" />
                </Grid>
            </Grid>
            <Border x:Name="FullBar" Grid.Row="1" Padding="8" Background="#ED181818"
                PointerEntered="OnControlsEntered" PointerExited="OnControlsExited">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="PrevButton" Click="OnPrevClick" IsEnabled="False" ToolTipService.ToolTip="Папярэдняя глава" AutomationProperties.Name="Папярэдняя глава"><SymbolIcon Symbol="Previous" /></Button>
                        <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
                        <Button x:Name="NextButton" Grid.Column="2" Click="OnNextClick" IsEnabled="False" ToolTipService.ToolTip="Наступная глава" AutomationProperties.Name="Наступная глава"><SymbolIcon Symbol="Next" /></Button>
                        <StackPanel x:Name="WindowActions" Grid.Column="3" Orientation="Horizontal" Spacing="4">
                            <Button Click="OnCollapseClick" ToolTipService.ToolTip="Выплыўное акно" AutomationProperties.Name="Выплыўное акно"><FontIcon Glyph="&#xE8A7;" /></Button>
                            <Button x:Name="FullscreenButton" Click="OnFullscreenClick" ToolTipService.ToolTip="На ўвесь экран" AutomationProperties.Name="На ўвесь экран"><SymbolIcon x:Name="FullscreenIcon" Symbol="FullScreen" /></Button>
                            <Button Click="OnCloseClick" ToolTipService.ToolTip="Закрыць" AutomationProperties.Name="Закрыць"><SymbolIcon Symbol="Cancel" /></Button>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="PreviousPageButton" Click="OnPreviousPageClick" ToolTipService.ToolTip="Папярэдняя старонка" AutomationProperties.Name="Папярэдняя старонка"><SymbolIcon x:Name="PreviousPageIcon" Symbol="Back" /></Button>
                        <ComboBox x:Name="PagePicker" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="80" SelectionChanged="OnPageSelected" AutomationProperties.Name="Старонка" />
                        <Button x:Name="NextPageButton" Grid.Column="2" Click="OnNextPageClick" ToolTipService.ToolTip="Наступная старонка" AutomationProperties.Name="Наступная старонка"><SymbolIcon x:Name="NextPageIcon" Symbol="Forward" /></Button>
                        <Button Grid.Column="3" ToolTipService.ToolTip="Налады чытання" AutomationProperties.Name="Налады чытання">
                            <SymbolIcon Symbol="Setting" />
                            <Button.Flyout>
                                <Flyout x:Name="ReadingOptions">
                                    <StackPanel Spacing="12" MinWidth="220">
                                        <ComboBox x:Name="ModeCombo" Header="Рэжым чытання" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnReadingOptionChanged">
                                            <ComboBoxItem Content="Пракрутка" /><ComboBoxItem Content="Па старонках" />
                                        </ComboBox>
                                        <ComboBox x:Name="FitCombo" Header="Маштаб старонкі" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="OnReadingOptionChanged">
                                            <ComboBoxItem Content="Уся старонка" /><ComboBoxItem Content="Па шырыні" />
                                        </ComboBox>
                                        <ToggleSwitch x:Name="RightToLeft" Header="Справа налева" Toggled="OnDirectionChanged" />
                                        <TextBlock Text="Маштаб" />
                                        <Slider x:Name="ZoomSlider" Minimum="1" Maximum="3" StepFrequency="0.25" Value="1" ValueChanged="OnZoomChanged" AutomationProperties.Name="Маштаб" />
                                        <Button Content="Скінуць маштаб" Click="OnResetZoomClick" />
                                        <TextBlock Text="← / → — старонкі
Home / End — пачатак / канец" FontSize="12" Opacity="0.7" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
