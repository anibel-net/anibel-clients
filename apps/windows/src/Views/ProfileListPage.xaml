<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Anibel.App.Views.ProfileListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anibel.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
    </Page.Resources>

    <Grid>
        <local:MediaCollectionView
            x:Name="ListView"
            ShowSkeleton="{x:Bind Vm.IsBusy, Mode=OneWay}"
            MediaClick="OnMediaClick" />
        <local:EmptyState Title="Спіс пусты"
                          Message="{x:Bind Vm.EmptyHint, Mode=OneWay}"
                          Glyph="&#xE8A5;"
                          Visibility="{x:Bind Vm.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolVis}}" />
        <local:EmptyState Title="Прабачце!"
                          Message="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                          Glyph="&#xE7BA;"
                          ActionText="Абнавіць"
                          SecondaryText="Капіяваць"
                          ActionClick="OnRetryClick"
                          SecondaryClick="OnCopyStatusClick"
                          Visibility="{x:Bind Vm.ShowErrorState, Mode=OneWay, Converter={StaticResource BoolVis}}" />
    </Grid>
</Page>
