<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Anibel.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anibel.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
    </Page.Resources>

    <Grid Padding="16,8,16,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                MaxWidth="720"
                HorizontalAlignment="Left"
                QueryIcon="Find"
                PlaceholderText="Назва, тып, год…"
                QuerySubmitted="OnSearchSubmitted" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Vm.Stats, Mode=OneWay}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <CommandBar DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed"
                            Background="Transparent">
                    <AppBarToggleButton x:Name="GridToggle" Icon="ViewAll" Label="Сетка" IsChecked="True"
                                        Click="OnGridToggle" />
                    <AppBarToggleButton x:Name="ListToggle" Icon="List" Label="Спіс" Click="OnListToggle" />
                </CommandBar>
            </StackPanel>
        </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
            <local:MediaCollectionView ItemsSource="{x:Bind Vm.Items, Mode=OneWay}"
                                       IsGridMode="{x:Bind Vm.IsGridMode, Mode=OneWay}"
                                       ShowSkeleton="{x:Bind Vm.IsBusy, Mode=OneWay}"
                                       MediaClick="OnMediaClick" />
            <local:EmptyState Title="Што шукаем?"
                              Message="Увядзіце назву — напрыклад «death note»."
                              Glyph="&#xE721;"
                              Visibility="{x:Bind Vm.ShowIdleState, Mode=OneWay, Converter={StaticResource BoolVis}}" />
            <local:EmptyState Title="Нічога не знойдзена"
                              Message="Паспрабуйце іншую назву або праверце напісанне."
                              Glyph="&#xE71C;"
                              Visibility="{x:Bind Vm.ShowNoResults, Mode=OneWay, Converter={StaticResource BoolVis}}" />
            <local:EmptyState Title="Прабачце!"
                              Message="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                              Glyph="&#xE7BA;"
                              ActionText="Паўтарыць"
                              SecondaryText="Капіяваць"
                              ActionClick="OnRetrySearchClick"
                              SecondaryClick="OnCopyStatusClick"
                              Visibility="{x:Bind Vm.ShowErrorState, Mode=OneWay, Converter={StaticResource BoolVis}}" />

        </Grid>
    </Grid>
</Page>
