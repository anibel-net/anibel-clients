<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Anibel.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anibel.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </Page.Resources>

    <Grid Padding="16,8,16,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="SearchPanel" Grid.Row="0" Spacing="16">
        <StackPanel x:Name="SearchIntro" Spacing="12" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Што шукаем?" Style="{StaticResource TitleTextBlockStyle}" />
        </StackPanel>
        <Grid ColumnSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.ColumnSpan="2"
                MaxWidth="720"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                MinHeight="44"
                TextBoxStyle="{StaticResource SearchTextBox}"
                QueryIcon="Find"
                PlaceholderText="Назва, тып, год…"
                QuerySubmitted="OnSearchSubmitted" />
            <Grid x:Name="SearchTools" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Visibility="{x:Bind Vm.HasCount, Mode=OneWay, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Вынікі" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Padding="10,3" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{x:Bind Vm.Stats, Mode=OneWay}" FontSize="12" AutomationProperties.Name="Знойдзена тайтлаў" />
                    </Border>
                </StackPanel>
                <CommandBar Grid.Column="1" DefaultLabelPosition="Right" OverflowButtonVisibility="Collapsed"
                            Background="Transparent">
                    <AppBarToggleButton x:Name="GridToggle" Icon="ViewAll" Label="Сетка" IsChecked="True"
                                        Click="OnGridToggle" />
                    <AppBarToggleButton x:Name="ListToggle" Icon="List" Label="Спіс" Click="OnListToggle" />
                </CommandBar>
            </Grid>
        </Grid>
        </StackPanel>

        <Grid x:Name="SearchResults" Grid.Row="1">
            <local:MediaCollectionView ItemsSource="{x:Bind Vm.Items, Mode=OneWay}"
                                       IsGridMode="{x:Bind Vm.IsGridMode, Mode=OneWay}"
                                       ShowSkeleton="{x:Bind Vm.IsBusy, Mode=OneWay}"
                                       MediaClick="OnMediaClick" />

            <local:EmptyState Title="Нічога не знойдзена"
                              Message="Паспрабуйце іншую назву або праверце напісанне."
                              Glyph="&#xE71C;"
                              Visibility="{x:Bind Vm.ShowNoResults, Mode=OneWay, Converter={StaticResource BoolVis}}" />
            <local:EmptyState Title="Прабачце!"
                              Message="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                              Glyph="&#xE7BA;"
                              ActionText="Паўтарыць"
                              SecondaryText="Капіяваць"
                              ActionClick="OnRetrySearchClick"
                              SecondaryClick="OnCopyStatusClick"
                              Visibility="{x:Bind Vm.ShowErrorState, Mode=OneWay, Converter={StaticResource BoolVis}}" />

        </Grid>
    </Grid>
</Page>
