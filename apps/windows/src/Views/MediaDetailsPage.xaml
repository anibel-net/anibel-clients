<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Anibel.App.Views.MediaDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anibel.App.Views"
    xmlns:core="using:Anibel.App.Core"
    xmlns:conv="using:Anibel.App.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:StringToImageConverter x:Key="Img" />
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:EpisodeNumberConverter x:Key="EpNumber" />
        <conv:EpisodeTitleConverter x:Key="EpTitle" />
        <conv:EpisodeSourceConverter x:Key="EpSource" />
        <conv:EpisodeResourceBadgeConverter x:Key="EpResBadge" />
        <conv:EpisodeWatchedOpacityConverter x:Key="EpWatchedOpacity" />
        <conv:ChapterNumberConverter x:Key="ChNumber" />
        <conv:ChapterTitleConverter x:Key="ChTitle" />
        <conv:CommentUsernameConverter x:Key="CommentUser" />
        <conv:CommentDateConverter x:Key="CommentDate" />
        <Style x:Key="FlushListItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FocusVisualMargin" Value="0" />
        </Style>
        <Style x:Key="PlainListItem" TargetType="ListViewItem" BasedOn="{StaticResource FlushListItem}">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" Padding="20,12,20,0" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Root.Padding" Value="10,8,10,0" />
                        <Setter Target="PosterHost.Width" Value="120" />
                        <Setter Target="PosterHost.Height" Value="168" />
                        <Setter Target="HeaderBlock.ColumnSpacing" Value="12" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Root.Padding" Value="20,12,20,0" />
                        <Setter Target="PosterHost.Width" Value="200" />
                        <Setter Target="PosterHost.Height" Value="280" />
                        <Setter Target="HeaderBlock.ColumnSpacing" Value="20" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="StatusBar" Grid.Row="0" Severity="Error" IsClosable="True">
            <InfoBar.ActionButton>
                <Button Content="Капіяваць" Click="OnCopyStatusClick" />
            </InfoBar.ActionButton>
        </InfoBar>
        <local:EmptyState x:Name="PageError" Grid.Row="0" Grid.RowSpan="3"
                          Title="Прабачце!"
                          Glyph="&#xE7BA;"
                          ActionText="Абнавіць"
                          SecondaryText="Капіяваць"
                          ActionClick="OnRetryLoadClick"
                          SecondaryClick="OnCopyStatusClick"
                          Visibility="Collapsed" />

        <Grid x:Name="LoadingHost" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Width="200" Height="280" CornerRadius="8"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top" Margin="0,8,0,0">
                <Border Height="28" Width="280" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                <Border Height="14" Width="180" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorTertiaryBrush}" HorizontalAlignment="Left" />
                <Border Height="14" Width="220" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorTertiaryBrush}" HorizontalAlignment="Left" />
                <Border Height="48" Width="360" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorTertiaryBrush}" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16" Margin="0,20,0,0">
                <Border Height="8" Width="72" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Border Height="8" Width="64" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorTertiaryBrush}" />
                <Border Height="8" Width="88" CornerRadius="4"
                        Background="{ThemeResource SubtleFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- header -->
        <Grid x:Name="HeaderBlock" Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PosterHost" Width="200" Height="280" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Image x:Name="PosterImage" Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="MetaText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="GenresText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="RatingText" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" MaxLines="5"
                           TextTrimming="CharacterEllipsis" Opacity="0.92" />

                <Grid x:Name="PersonalPanel" ColumnSpacing="12" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Закладка" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    <ToggleButton x:Name="FavoriteButton" Grid.Row="1" Click="OnFavoriteClick"
                                  Height="32" Padding="12,0" VerticalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE734;" FontSize="14" />
                            <TextBlock Text="Упадабанае" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock Grid.Column="1" Text="Мой статус" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="MarkCombo" Grid.Column="1" Grid.Row="1" MinWidth="180" Height="32"
                              SelectionChanged="OnMarkChanged" />
                </Grid>
            </StackPanel>
        </Grid>

        <Pivot x:Name="ContentPivot" Grid.Row="2" Margin="0" Padding="0">
            <Pivot.Resources>
                <Style TargetType="PivotItem">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </Pivot.Resources>
            <PivotItem x:Name="EpisodesPivot" Header="Эпізоды">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SelectorBar x:Name="KindBar" HorizontalAlignment="Left"
                                     SelectionChanged="OnKindChanged" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <ComboBox x:Name="ResourceCombo" MinWidth="180"
                                      SelectionChanged="OnFilterChanged" />
                            <Button Click="OnDownloadAllEpisodesClick"
                                    ToolTipService.ToolTip="Спампаваць усе эпізоды гэтага спісу">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="Спампаваць усе" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ProgressRing x:Name="EpisodesLoadingRing" IsActive="False" Width="32" Height="32"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ListView
                            x:Name="EpisodesList"
                            Padding="0"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ItemContainerStyle="{StaticResource FlushListItem}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnEpisodeClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:EpisodeDto">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,10"
                                            HorizontalAlignment="Stretch">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44" Height="44" CornerRadius="8"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                <TextBlock Text="{x:Bind Converter={StaticResource EpNumber}}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"
                                                        HorizontalAlignment="Stretch">
                                                <TextBlock Text="{x:Bind Converter={StaticResource EpTitle}}" TextWrapping="Wrap" MaxLines="2"
                                                           TextAlignment="Left" />
                                                <TextBlock Text="{x:Bind Converter={StaticResource EpSource}}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{x:Bind Converter={StaticResource EpResBadge}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <Button Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Прагледжана"
                                                        Tag="{x:Bind}" Click="OnWatchedClick"
                                                        Opacity="{x:Bind Watched, Converter={StaticResource EpWatchedOpacity}, Mode=OneWay}">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                                </Button>
                                                <Button Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Спампаваць відэа"
                                                        Tag="{x:Bind}" Click="OnDownloadEpisodeClick">
                                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                                </Button>
                                                <Button Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Спампаваць аўдыё"
                                                        Tag="{x:Bind}" Click="OnDownloadEpisodeAudioClick">
                                                    <FontIcon Glyph="&#xE189;" FontSize="14" />
                                                </Button>
                                                <FontIcon Glyph="&#xE768;" FontSize="14" Opacity="0.55" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <local:EmptyState x:Name="EpisodesEmpty" Title="Няма эпізодаў"
                                          Message="Для гэтага раскладу пакуль няма серый."
                                          Glyph="&#xE7F4;" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </PivotItem>

            <PivotItem x:Name="ChaptersPivot" Header="Главы">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button HorizontalAlignment="Right" Click="OnDownloadAllChaptersClick"
                            ToolTipService.ToolTip="Спампаваць усе главы">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock Text="Спампаваць усе" />
                        </StackPanel>
                    </Button>
                    <Grid Grid.Row="1">
                    <ProgressRing x:Name="ChaptersLoadingRing" IsActive="False" Width="32" Height="32"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ListView x:Name="ChaptersList" SelectionMode="None"
                              Padding="0" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              IsItemClickEnabled="True"
                              ItemClick="OnChapterClick"
                              ItemContainerStyle="{StaticResource FlushListItem}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:ChapterDto">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,10"
                                        HorizontalAlignment="Stretch">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="8"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{x:Bind Converter={StaticResource ChNumber}}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Converter={StaticResource ChTitle}}" TextWrapping="Wrap"
                                                   MaxLines="2" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Button Background="Transparent" BorderThickness="0"
                                                    ToolTipService.ToolTip="Спампаваць главу"
                                                    Tag="{x:Bind}" Click="OnDownloadChapterClick">
                                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                            </Button>
                                            <FontIcon Glyph="&#xE8A1;" FontSize="14" Opacity="0.55" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <local:EmptyState x:Name="ChaptersEmpty" Title="Глаў пакуль няма"
                                      Message="Главы яшчэ не дададзены да гэтага тайтла."
                                      Glyph="&#xE8A5;" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </PivotItem>

            <PivotItem x:Name="GamePivot" Header="Гульня">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="4,12">
                        <TextBlock Text="Гульні — гэта картка з апісаннем і спасылкамі. Эпізодаў і глаў тут няма."
                                   TextWrapping="Wrap" Opacity="0.85" />
                        <TextBlock x:Name="GameLanguages" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="GameInstructions" TextWrapping="Wrap" />
                        <HyperlinkButton x:Name="TrailerLink" Content="Трэйлер" />
                        <HyperlinkButton x:Name="DownloadLink" Content="Спампаваць / старонка" />
                        <Button x:Name="GameSaveButton" Content="Спампаваць файл у бібліятэку"
                                Click="OnDownloadMediaFileClick" Visibility="Collapsed" />
                        <local:EmptyState x:Name="GameEmpty" Title="Няма спасылак"
                                          Message="Дадатковых спасылак на трэйлер або файл пакуль няма."
                                          Glyph="&#xE71B;" MinHeight="240" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem x:Name="BookPivot" Header="Кніга">
                <ScrollViewer>
                    <StackPanel Spacing="12" Padding="4,12">
                        <TextBlock Text="Кнігі на Anibel — гэта тэкст для чытання. Главы як у манзе і відэаэпізоды тут не паказваюцца."
                                   TextWrapping="Wrap" Opacity="0.85" />
                        <TextBlock x:Name="BookLanguages" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="BookInstructions" TextWrapping="Wrap" />
                        <HyperlinkButton x:Name="BookDownloadLink" Content="Спампаваць / чытаць" />
                        <Button x:Name="BookSaveButton" Content="Спампаваць файл у бібліятэку"
                                Click="OnDownloadMediaFileClick" Visibility="Collapsed" />
                        <local:EmptyState x:Name="BookEmpty" Title="Няма файла"
                                          Message="Спасылкі на файл пакуль няма."
                                          Glyph="&#xE8A5;" MinHeight="240" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem x:Name="FranchisePivot" Header="Франшыза">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FranchiseNameText" Style="{StaticResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <local:EmptyState x:Name="FranchiseEmpty" Grid.Row="1"
                                      Title="Няма іншых частак"
                                      Message="Іншых частак франшызы пакуль няма."
                                      Glyph="&#xE8F1;" Visibility="Collapsed" />
                    <local:MediaCollectionView x:Name="FranchiseList" Grid.Row="1"
                                               MediaClick="OnRelatedClick" />
                </Grid>
            </PivotItem>

            <PivotItem x:Name="RecsPivot" Header="Рэкамендацыі">
                <local:MediaCollectionView x:Name="RecsList" MediaClick="OnRelatedClick" />
            </PivotItem>

            <PivotItem x:Name="CommentsPivot" Header="Каментары">
                <Grid HorizontalAlignment="Stretch" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                    <Border x:Name="ReplyChip" Visibility="Collapsed" Padding="10,6" CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReplyChipText" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <HyperlinkButton Grid.Column="1" Content="Скасаваць" Click="OnCancelReplyClick"
                                             Padding="0" MinHeight="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Grid x:Name="CommentComposer" ColumnSpacing="8" Visibility="Collapsed" Padding="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CommentBox" PlaceholderText="Напісаць каментар…"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"
                                 MaxLength="2000" />
                        <Button Grid.Column="1" Content="Даслаць" Style="{StaticResource AccentButtonStyle}"
                                VerticalAlignment="Bottom" MinWidth="96" Height="32" Click="OnSendCommentClick" />
                    </Grid>
                    <TextBlock x:Name="CommentLoginHint" Text="Увайдзіце, каб пакінуць каментар"
                               Opacity="0.65" Visibility="Collapsed" Margin="0,4,0,0" />
                    </StackPanel>
                    <ProgressRing x:Name="CommentsLoadingRing" Grid.Row="1" IsActive="False" Width="32" Height="32"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ListView x:Name="CommentsList" Grid.Row="1"
                              Padding="0"
                              Margin="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              ItemContainerStyle="{StaticResource PlainListItem}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              SelectionMode="None">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:CommentDto">
                                <Grid HorizontalAlignment="Stretch" ColumnSpacing="12" Padding="0,4,8,8">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Капіяваць" Click="OnCopyCommentClick" />
                                            <MenuFlyoutItem Text="Адказаць" Click="OnReplyCommentClick" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Width="36" Height="36" VerticalAlignment="Top"
                                                   HorizontalAlignment="Left"
                                                   DisplayName="{x:Bind Converter={StaticResource CommentUser}}"
                                                   ProfilePicture="{Binding User.Avatar, Converter={StaticResource Img}}" />
                                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Stretch">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextAlignment="Left"
                                                   IsTextSelectionEnabled="True">
                                            <Run Text="{x:Bind Converter={StaticResource CommentUser}}" FontWeight="SemiBold" />
                                            <Run Text="  " /><Run Text="{x:Bind Converter={StaticResource CommentDate}}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" TextAlignment="Left"
                                                   IsTextSelectionEnabled="True" />
                                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,2,0,0">
                                            <HyperlinkButton Content="Капіяваць" Click="OnCopyCommentClick"
                                                             Padding="0" MinHeight="0" FontSize="12" />
                                            <HyperlinkButton Content="Адказаць" Click="OnReplyCommentClick"
                                                             Padding="0" MinHeight="0" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <local:EmptyState x:Name="CommentsEmpty" Grid.Row="1"
                                      Title="Цішыня"
                                      Message="Каментароў пакуль няма. Будзьце першым."
                                      Glyph="&#xE8F2;" Visibility="Collapsed" />
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
