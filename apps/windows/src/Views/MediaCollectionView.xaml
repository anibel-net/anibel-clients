<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Anibel.App.Views.MediaCollectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Anibel.App.Core"
    xmlns:local="using:Anibel.App.Views"
    xmlns:conv="using:Anibel.App.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:StringToImageConverter x:Key="Img" />
        <conv:CardTitleConverter x:Key="CardTitle" />
        <conv:CardMetaLineConverter x:Key="CardMeta" />
        <conv:CardStatusLabelConverter x:Key="CardStatus" />
        <conv:CardLanguageLabelConverter x:Key="CardLang" />
        <conv:CardNumLabelConverter x:Key="CardNum" />
        <conv:CardInfoLineConverter x:Key="CardInfo" />
        <conv:CardFlagVisibilityConverter x:Key="CardShowStatus" Flag="status" />
        <conv:CardFlagVisibilityConverter x:Key="CardShowSub" Flag="sub" />
        <conv:CardFlagVisibilityConverter x:Key="CardShowDub" Flag="dub" />
        <conv:CardFlagVisibilityConverter x:Key="CardShowNum" Flag="num" />
        <conv:CardFlagVisibilityConverter x:Key="CardShowInfo" Flag="info" />

        <Style x:Key="PosterBadge" TargetType="Border">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#CC1C1C1C" />
        </Style>
        <Style x:Key="PosterBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="CardChrome" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <DataTemplate x:Key="GridCard" x:DataType="core:MediaCard">
            <Button Style="{StaticResource CardChrome}"
                    AutomationProperties.Name="{x:Bind Converter={StaticResource CardTitle}}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Tag="{x:Bind}"
                    Click="OnGridCardClick" KeyDown="OnGridCardKeyDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="68" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Border CornerRadius="8,8,0,0"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Image Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Source="{x:Bind Poster, Converter={StaticResource Img}, ConverterParameter=400}" />
                        </Border>
                        <Border Style="{StaticResource PosterBadge}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="6"
                                Visibility="{x:Bind Converter={StaticResource CardShowStatus}}">
                            <TextBlock Text="{x:Bind Converter={StaticResource CardStatus}}"
                                       Style="{StaticResource PosterBadgeText}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="6">
                            <Border Style="{StaticResource PosterBadge}"
                                    Visibility="{x:Bind Converter={StaticResource CardShowSub}}">
                                <TextBlock Text="Суб" Style="{StaticResource PosterBadgeText}" />
                            </Border>
                            <Border Style="{StaticResource PosterBadge}"
                                    Visibility="{x:Bind Converter={StaticResource CardShowDub}}">
                                <TextBlock Text="Дуб" Style="{StaticResource PosterBadgeText}" />
                            </Border>
                        </StackPanel>
                        <Border Style="{StaticResource PosterBadge}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="6"
                                Visibility="{x:Bind Converter={StaticResource CardShowNum}}">
                            <TextBlock Text="{x:Bind Converter={StaticResource CardNum}}"
                                       Style="{StaticResource PosterBadgeText}" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Padding="10,6,10,8" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Converter={StaticResource CardTitle}}" MaxLines="2" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Converter={StaticResource CardMeta}}" Style="{StaticResource CaptionTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="RowCard" x:DataType="core:MediaCard">
            <Grid ColumnSpacing="14" Padding="12,10" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Image Width="72" Height="108" Stretch="UniformToFill"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="{x:Bind Poster, Converter={StaticResource Img}, ConverterParameter=160}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind Converter={StaticResource CardTitle}}" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" MaxLines="2" />
                        <TextBlock Text="{x:Bind Converter={StaticResource CardMeta}}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Converter={StaticResource CardInfo}}"
                                   Visibility="{x:Bind Converter={StaticResource CardShowInfo}}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Grid>
        </DataTemplate>

        <Style x:Key="GridItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FocusVisualMargin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="ListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FocusVisualMargin" Value="0" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer
            x:Name="GridScroll"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Visible"
            VerticalScrollMode="Enabled"
            HorizontalAlignment="Stretch">
            <ItemsRepeater
                x:Name="GridRepeater"
                HorizontalAlignment="Stretch"
                VerticalCacheLength="6"
                HorizontalCacheLength="2"
                ItemTemplate="{StaticResource GridCard}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        x:Name="GridLayout"
                        MinItemWidth="160"
                        MinItemHeight="308"
                        MinColumnSpacing="8"
                        MinRowSpacing="8"
                        ItemsStretch="Fill"
                        ItemsJustification="Start" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <ListView
            x:Name="ListHost"
            IsItemClickEnabled="True"
            SelectionMode="None"
            IncrementalLoadingTrigger="Edge"
            IncrementalLoadingThreshold="0.8"
            ItemClick="OnItemClick"
            ItemTemplate="{StaticResource RowCard}"
            ItemContainerStyle="{StaticResource ListItemStyle}"
            Visibility="Collapsed"
            Padding="0"
            Margin="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch" />

        <ItemsRepeater
            x:Name="SkeletonHost"
            IsHitTestVisible="False"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    x:Name="SkeletonLayout"
                    MinItemWidth="160"
                    MinItemHeight="308"
                    MinColumnSpacing="8"
                    MinRowSpacing="8"
                    ItemsStretch="Fill"
                    ItemsJustification="Start" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="68" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="8,8,0,0"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" />
                            <StackPanel Grid.Row="1" Padding="10,10,10,8" Spacing="8" VerticalAlignment="Center">
                                <Border Height="12" Width="120" CornerRadius="4"
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        HorizontalAlignment="Left" />
                                <Border Height="10" Width="72" CornerRadius="4"
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </Grid>
</UserControl>
