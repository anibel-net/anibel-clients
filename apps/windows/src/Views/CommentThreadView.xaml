<UserControl x:Class="Anibel.App.Views.CommentThreadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Anibel.App.Core" xmlns:local="using:Anibel.App.Views">
    <StackPanel Spacing="8" Padding="0,6,8,10">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="AvatarButton" Click="OnAuthorClick" Padding="0" Background="Transparent"
                    BorderThickness="0" VerticalAlignment="Top">
                <PersonPicture x:Name="Avatar" Width="36" Height="36" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <HyperlinkButton x:Name="AuthorButton" Padding="0" MinHeight="0" Click="OnAuthorClick" />
                    <TextBlock x:Name="DateText" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="BodyText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <HyperlinkButton Content="Адказаць" Click="OnReplyClick" Padding="0" MinHeight="0" FontSize="12" />
                    <HyperlinkButton Content="Капіяваць" Click="OnCopyClick" Padding="0" MinHeight="0" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Border x:Name="ReplyBorder" Margin="20,4,0,0" Padding="12,0,0,0" BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <ItemsControl x:Name="Replies">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:CommentDto">
                        <local:CommentThreadView Comment="{x:Bind}" ReplyRequested="OnChildReply" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
