<UserControl
    x:Class="Anibel.App.Views.ShortcutHelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="24">
        <TextBlock Text="Усё пад рукой — без мышы."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid x:Name="Sections" ColumnSpacing="28" RowSpacing="28" SizeChanged="OnSectionsSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="NavigationSection">
                <TextBlock Text="Навігацыя" Style="{StaticResource SectionTitle}" />
                <StackPanel x:Name="NavigationRows" Spacing="10" />
                <TextBlock Text="Націсніце g, затым клавішу старонкі."
                           FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel x:Name="ActionSection" Grid.Column="1">
                <TextBlock Text="Дзеянні" Style="{StaticResource SectionTitle}" />
                <StackPanel x:Name="ActionRows" Spacing="10" />
            </StackPanel>
            <StackPanel x:Name="MediaSection" Grid.Column="2">
                <TextBlock Text="Відэа" Style="{StaticResource SectionTitle}" />
                <StackPanel x:Name="MediaRows" Spacing="10" />
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,24,0,16" />
                <TextBlock Text="Клавішы відэа дзейнічаюць у актыўным прайгравальніку. Кожнае выплыўное акно мае ўласнае кіраванне."
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
            <TextBlock Text="Спалучэнні навігацыі не дзейнічаюць падчас уводу тэксту."
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </StackPanel>
</UserControl>
