<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Anibel.App.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anibel.App.Views"
    xmlns:svc="using:Anibel.App.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:StringToImageConverter x:Key="Img" />
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InvVis" />
        <Style x:Key="FlushListItem" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,12,20,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Спампаванае" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Глядзіце і чытайце без інтэрнэту, або захавайце файлы на дыск."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="FilterBar" Grid.Row="1" HorizontalAlignment="Left" SelectionChanged="OnFilterChanged">
                <SelectorBarItem Text="Усе" Tag="all" IsSelected="True" />
                <SelectorBarItem Text="У працэсе" Tag="active" />
                <SelectorBarItem Text="Гатова" Tag="ready" />
            </SelectorBar>
            <TextBox Grid.ColumnSpan="4" HorizontalAlignment="Stretch" MinHeight="40"
                     VerticalContentAlignment="Center"
                     PlaceholderText="Пошук у бібліятэцы"
                     Text="{x:Bind Vm.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind Vm.DiskLabel, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Row="1" Grid.Column="3" Content="Папка" Click="OnOpenFolderClick"
                    ToolTipService.ToolTip="Адкрыць папку спамповак" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView
                x:Name="List"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                SelectionMode="None"
                ItemContainerStyle="{StaticResource FlushListItem}"
                ItemsSource="{x:Bind Vm.Visible, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:DownloadItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Width="56" Height="80" CornerRadius="6" Grid.RowSpan="3" VerticalAlignment="Top"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Image Stretch="UniformToFill"
                                           Source="{Binding DisplayPoster, Converter={StaticResource Img}, ConverterParameter=160}" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind KindLabel, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Opacity="0.7" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"
                                            Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolVis}}">
                                    <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                 Maximum="100" IsIndeterminate="{x:Bind ProgressIsUnknown, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ProgressLabel, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <InfoBar Grid.Row="1" Grid.Column="1"
                                         Severity="Error" IsClosable="False" IsOpen="True"
                                         Message="{x:Bind Error, Mode=OneWay}"
                                         Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolVis}}">
                                    <InfoBar.ActionButton>
                                        <Button Content="Скапіяваць" Tag="{x:Bind Error, Mode=OneWay}"
                                                Click="OnCopyErrorClick" />
                                    </InfoBar.ActionButton>
                                </InfoBar>

                                <local:WrapPanel Grid.Row="2" Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button Content="{x:Bind PlayLabel, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Tag="{x:Bind}" Click="OnPlayClick"
                                            Visibility="{x:Bind CanPlay, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                    <Button Content="Захаваць файл" Tag="{x:Bind}" Click="OnSaveClick"
                                            Visibility="{x:Bind CanSave, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                    <Button Content="Скасаваць" Tag="{x:Bind}" Click="OnCancelClick"
                                            Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                    <Button Content="Паўтарыць" Tag="{x:Bind}" Click="OnRetryClick"
                                            Visibility="{x:Bind CanRetry, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                    <Button Content="Выдаліць" Tag="{x:Bind}" Click="OnDeleteClick"
                                            Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource InvVis}}" />
                                    <Button Content="Да тайтла" Tag="{x:Bind}" Click="OnOpenTitleClick"
                                            Visibility="{x:Bind HasSlug, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                </local:WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <local:EmptyState Title="Няма спамповак"
                              Message="Спампуйце серыі, аўдыё або главы мангі са старонкі тайтла. Гэтая старонка працуе без інтэрнэту."
                              Glyph="&#xE896;"
                              Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVis}}" />
        </Grid>
    </Grid>
</Page>
