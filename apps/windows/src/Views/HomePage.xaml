<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Anibel.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Anibel.App.Core"
    xmlns:local="using:Anibel.App.Views"
    xmlns:conv="using:Anibel.App.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <local:StringToImageConverter x:Key="Img" />
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:SlideTitleConverter x:Key="SlideTitle" />
        <conv:SlideContentConverter x:Key="SlideContent" />
        <Style x:Key="HeroNavButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" Padding="16,8,16,0" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroStage.Height" Value="180" />
                        <Setter Target="Root.Padding" Value="10,6,10,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeroStage.Height" Value="320" />
                        <Setter Target="Root.Padding" Value="16,8,16,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeroHost" Grid.Row="0"
              Visibility="{x:Bind Vm.HasSlides, Mode=OneWay, Converter={StaticResource BoolVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="HeroStage" Height="320">
                <FlipView
                    x:Name="HeroCarousel"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    UseSystemFocusVisuals="True"
                    Loaded="OnHeroCarouselLoaded"
                    ItemsSource="{x:Bind Vm.Slides, Mode=OneWay}"
                    SelectionChanged="OnHeroSelectionChanged">
                    <FlipView.ItemContainerStyle>
                        <Style TargetType="FlipViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </FlipView.ItemContainerStyle>
                    <FlipView.ItemTemplate>
                        <DataTemplate x:DataType="core:SlideDto">
                            <Grid Tapped="OnSlideTapped" Tag="{x:Bind}"
                                  Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <Image Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Source="{x:Bind Img, Converter={StaticResource Img}, ConverterParameter=480}" />
                                <Border VerticalAlignment="Bottom">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#A8000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Padding="20,36,20,16" Spacing="4">
                                        <TextBlock Text="{x:Bind Converter={StaticResource SlideTitle}}"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                   Foreground="White"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Converter={StaticResource SlideContent}}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="#CCFFFFFF"
                                                   TextWrapping="Wrap"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </FlipView.ItemTemplate>
                </FlipView>
                <Button x:Name="HeroPrev" Style="{StaticResource HeroNavButton}"
                        HorizontalAlignment="Left" Margin="12,0,0,0"
                        Click="OnHeroPrev" ToolTipService.ToolTip="Папярэдні">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" />
                </Button>
                <Button x:Name="HeroNext" Style="{StaticResource HeroNavButton}"
                        HorizontalAlignment="Right" Margin="0,0,12,0"
                        Click="OnHeroNext" ToolTipService.ToolTip="Наступны">
                    <FontIcon Glyph="&#xE76C;" FontSize="14" />
                </Button>
            </Grid>
            <PipsPager
                x:Name="HeroPips"
                Grid.Row="1"
                NumberOfPages="1"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                PreviousButtonVisibility="Collapsed"
                NextButtonVisibility="Collapsed"
                SelectedIndexChanged="OnHeroPipsChanged" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Апошнія абнаўленні" Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <SelectorBar x:Name="UpdateKindBar" Grid.Column="1" HorizontalAlignment="Left"
                         Margin="12,0,0,0" SelectionChanged="OnUpdateKindChanged">
                <SelectorBarItem Text="Усе" Tag="ALL" />
                <SelectorBarItem Text="Субцітры" Tag="SUB" />
                <SelectorBarItem Text="Дубляж" Tag="DUB" />
                <SelectorBarItem Text="Кіно" Tag="CINEMA" />
                <SelectorBarItem Text="Манга" Tag="MANGA" />
                <SelectorBarItem Text="Гульні" Tag="GAMES" />
            </SelectorBar>
            <Button Grid.Column="2" Click="OnRefreshClick" ToolTipService.ToolTip="Абнавіць з сеткі"
                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                <SymbolIcon Symbol="Refresh" />
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <local:MediaCollectionView
                x:Name="UpdatesView"
                ItemsSource="{x:Bind Vm.Updates, Mode=OneWay}"
                HasMore="{x:Bind Vm.HasMore, Mode=OneWay}"
                ShowSkeleton="{x:Bind Vm.UpdatesBusy, Mode=OneWay}"
                MediaClick="OnMediaClick"
                LoadMoreRequested="OnLoadMore" />
            <local:EmptyState Title="Пакуль ціха"
                              Message="Абнаўленняў зараз няма. Зайдзіце пазней або абнавіце старонку."
                              Glyph="&#xE787;"
                              ActionText="Абнавіць"
                              ActionClick="OnRefreshClick"
                              Visibility="{x:Bind Vm.ShowUpdatesEmpty, Mode=OneWay, Converter={StaticResource BoolVis}}" />
            <local:EmptyState Title="Прабачце!"
                              Message="{x:Bind Vm.StatusMessage, Mode=OneWay}"
                              Glyph="&#xE7BA;"
                              ActionText="Абнавіць"
                              SecondaryText="Капіяваць"
                              ActionClick="OnRefreshClick"
                              SecondaryClick="OnCopyStatusClick"
                              Visibility="{x:Bind Vm.ShowUpdatesError, Mode=OneWay, Converter={StaticResource BoolVis}}" />
        </Grid>
    </Grid>
</Page>
