<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Anibel.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anibel.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>
                    <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:String x:Key="AppTitle">Anibel.Net</x:String>
            <Thickness x:Key="GridViewItemPadding">0</Thickness>
            <Thickness x:Key="ListViewItemPadding">0</Thickness>
            <Thickness x:Key="ListViewItemPresenterPadding">0</Thickness>
            <x:Double x:Key="ListViewItemMinWidth">0</x:Double>
            <Style TargetType="ListView">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="GridView">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
