<UserControl x:Class="Anibel.App.Views.ProfileEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" MinWidth="280" MaxWidth="560">
            <Grid Height="160" CornerRadius="8">
                <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#55351F" Offset="0"/><GradientStop Color="#28252F" Offset="1"/></LinearGradientBrush></Grid.Background>
                <Image x:Name="WallpaperPreview" Stretch="UniformToFill" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
                    <Button Content="Змяніць фон" Tag="wallpaper" Click="OnPickImageClick" />
                    <Button Tag="wallpaper" Click="OnRemoveImageClick" ToolTipService.ToolTip="Выдаліць фон" AutomationProperties.Name="Выдаліць фон">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <PersonPicture x:Name="AvatarPreview" Width="72" Height="72" />
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Змяніць аватар" Tag="avatar" Click="OnPickImageClick" />
                        <Button Tag="avatar" Click="OnRemoveImageClick" ToolTipService.ToolTip="Выдаліць аватар" AutomationProperties.Name="Выдаліць аватар">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="PNG, JPEG, GIF, WebP · да 10 МіБ" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <TextBox x:Name="DisplayNameBox" Header="Імя" MaxLength="100" />
            <TextBox x:Name="BioBox" Header="Пра сябе" MaxLength="2000" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="96" MaxHeight="180" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
