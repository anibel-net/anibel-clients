<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Anibel.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:playback="using:Anibel.App.Playback"
    xmlns:reading="using:Anibel.App.Reading"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Visible"
            IsBackEnabled="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            OpenPaneLength="220"
            CompactPaneLength="48"
            IsPaneToggleButtonVisible="True"
            ItemInvoked="OnNavItemInvoked"
            BackRequested="OnBackRequested">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Главная" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Пошук" Tag="search">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Find" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Каталог" />
                <NavigationViewItem Content="Анімэ" Tag="anime">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Манга" Tag="manga">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE89A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Кіно" Tag="cinema">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Гульні" Tag="games">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Кнігі" Tag="books">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Профіль" Tag="profile">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Спампаванае" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Налады" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <StackPanel>
                    <Button Width="32" Height="32" Padding="0" Margin="8"
                            HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Спалучэнні клавіш"
                            ToolTipService.ToolTip="Спалучэнні клавіш (F1)"
                            Click="OnShortcutHelpClick">
                        <TextBlock Text="?" FontSize="18" FontWeight="SemiBold" />
                    </Button>
                <DropDownButton x:Name="OpenTitlesButton" Content="Адкрытыя тайтлы"
                                AutomationProperties.AutomationId="OpenTitles" Visibility="Collapsed" Margin="8">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="OpenTitlesMenu" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" Navigated="OnContentNavigated" />
        </NavigationView>
        <Grid x:Name="PlayerLayer" Background="{x:Null}" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</Page>
