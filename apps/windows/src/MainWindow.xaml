<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Anibel.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:views="using:Anibel.App.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Anibel.Net"
    mc:Ignorable="d">

    <Grid x:Name="WindowRoot" Background="Transparent" KeyDown="OnWindowKeyDown">
        <Grid.Resources>
            <views:StringToImageConverter x:Key="Img" />
            <views:BoolToVisibilityConverter x:Key="BoolVis" />
            <views:InverseBoolToVisibilityConverter x:Key="InvVis" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="SolidBackground" Grid.RowSpan="2"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />

        <!-- Microsoft Store-style title bar: branding | search | account | caption -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="12" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="BrandHost" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="8,0,4,0">
                <Image Source="ms-appx:///Assets/Logo.png" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Text="Anibel.Net"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Grid x:Name="SearchHost" Grid.Column="2" Padding="8,8">
                <AutoSuggestBox
                    x:Name="GlobalSearch"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    QueryIcon="Find"
                    MaxSuggestionListHeight="420"
                    PlaceholderText="Пошук анімэ, мангі, кіно, гульняў…"
                    UpdateTextOnSelect="False"
                    GotFocus="OnSearchGotFocus"
                    GettingFocus="OnSearchGettingFocus"
                    LostFocus="OnSearchLostFocus"
                    TextChanged="OnSearchTextChanged"
                    SuggestionChosen="OnSuggestionChosen"
                    QuerySubmitted="OnGlobalSearch">
                    <AutoSuggestBox.Resources>
                        <Thickness x:Key="TextControlBorderThemeThickness">0,0,0,2</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,2</Thickness>
                        <Thickness x:Key="AutoSuggestBoxSuggestionsListBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="AutoSuggestBoxSuggestionsListMargin">0,4,0,0</Thickness>
                        <x:Double x:Key="AutoSuggestBoxSuggestionsListMaxHeight">420</x:Double>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                                         Color="{ThemeResource SystemAccentColor}" />
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="8,2,4,2" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </AutoSuggestBox.Resources>
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="10" MinHeight="36" Padding="4,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="48" CornerRadius="3"
                                        Visibility="{Binding HasPoster, Converter={StaticResource BoolVis}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Poster, Converter={StaticResource Img}, ConverterParameter=64}"
                                                    Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border Width="32" Height="32" CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        Visibility="{Binding HasPoster, Converter={StaticResource InvVis}}">
                                    <FontIcon Glyph="{Binding Glyph}" FontSize="14"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2"
                                        Width="32" Height="32" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        CornerRadius="16"
                                        Tag="{Binding Title}"
                                        Click="OnRemoveHistoryClick"
                                        Visibility="{Binding IsHistory, Converter={StaticResource BoolVis}}"
                                        ToolTipService.ToolTip="Выдаліць">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Grid>

            <Button
                x:Name="AccountButton"
                Grid.Column="3"
                Width="32"
                Height="32"
                Padding="0"
                Margin="4,0,8,0"
                CornerRadius="16"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Профіль"
                VerticalAlignment="Center">
                <Button.Flyout>
                    <Flyout x:Name="AccountFlyout" Placement="BottomEdgeAlignedRight"
                            Opening="OnAccountFlyoutOpening">
                        <StackPanel Width="280" Spacing="2">
                            <Grid ColumnSpacing="12" Margin="4,2,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <PersonPicture x:Name="FlyoutPicture" Width="40" Height="40"
                                               DisplayName="Профіль" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                    <TextBlock x:Name="FlyoutName" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HyperlinkButton x:Name="FlyoutSignOut" Content="Выйсці"
                                                     Padding="0" Margin="0,2,0,0"
                                                     Click="OnFlyoutLogoutClick" />
                                    <HyperlinkButton x:Name="FlyoutSignIn" Content="Увайсці"
                                                     Padding="0" Margin="0,2,0,0"
                                                     Click="OnFlyoutProfileClick"
                                                     Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                            <MenuFlyoutSeparator />
                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="12,8" Click="OnFlyoutProfileClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" />
                                    <TextBlock Text="Профіль" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="12,8" Click="OnFlyoutDownloadsClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                                    <TextBlock Text="Спампаванае" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="12,8" Click="OnFlyoutSettingsClick">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                                    <TextBlock Text="Налады" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <PersonPicture
                    x:Name="AccountPicture"
                    Width="28"
                    Height="28"
                    DisplayName="Профіль" />
            </Button>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" />
        <InfoBar Grid.Row="1" VerticalAlignment="Top" Margin="12" Severity="Informational"
                 IsOpen="{x:Bind Updates.IsReady, Mode=OneWay}" IsClosable="True"
                 Title="Даступнае абнаўленне" Message="{x:Bind Updates.StatusLabel, Mode=OneWay}">
            <InfoBar.ActionButton><Button Content="Падрабязней" Click="OnUpdateDetailsClick" /></InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>
