<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Anibel.App.Playback.PipWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Anibel.Net">
    <Grid x:Name="Root" Background="Black"
          PointerEntered="OnRootPointerEntered"
          PointerMoved="OnRootPointerMoved"
          PointerExited="OnRootPointerExited"
          PointerPressed="OnRootPointerPressed" GotFocus="OnRootGotFocus">
        <Grid x:Name="Host" />

        <Grid x:Name="Chrome" Opacity="0" IsHitTestVisible="False"
              PointerPressed="OnRootPointerPressed">
            <Border x:Name="Shade" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#66000000" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.35" />
                    <GradientStop Color="#00000000" Offset="0.65" />
                    <GradientStop Color="#99000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            </Border>
            <Border x:Name="ReaderDragHandle" Height="48" VerticalAlignment="Top" Background="#CC111111" Visibility="Collapsed">
                <TextBlock x:Name="WindowTitle" Margin="12,0,96,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="White" IsHitTestVisible="False" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="8" Spacing="4" PointerEntered="OnControlsEntered" PointerExited="OnControlsExited">
                <Button x:Name="QualityButton" Click="OnQualityClick" ToolTipService.ToolTip="Якасць відэа" AutomationProperties.Name="Якасць відэа"
                        Width="32" Height="32" Padding="0" CornerRadius="16" Background="#CC111111" BorderThickness="0" Visibility="Collapsed">
                    <SymbolIcon Symbol="Setting" Foreground="White" />
                </Button>
                <Button x:Name="RestoreButton" Click="OnRestoreClick" ToolTipService.ToolTip="Вярнуць у акно"
                        Width="32" Height="32" Padding="0" CornerRadius="16"
                        Background="#CC111111" BorderThickness="0">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" Foreground="White" />
                </Button>
                <Button x:Name="CloseButton" Click="OnCloseClick" ToolTipService.ToolTip="Закрыць"
                        Width="32" Height="32" Padding="0" CornerRadius="16"
                        Background="#CC111111" BorderThickness="0">
                    <SymbolIcon Symbol="Cancel" Foreground="White" />
                </Button>
            </StackPanel>

            <Button x:Name="PlayButton" Click="OnPlayClick"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="52" Height="52" Padding="0" CornerRadius="26"
                    Background="#CC111111" BorderThickness="0"
                    ToolTipService.ToolTip="Прайграць / паўза">
                <SymbolIcon x:Name="PlayIcon" Symbol="Pause" Foreground="White" />
            </Button>

            <Slider x:Name="SeekSlider" VerticalAlignment="Bottom" Margin="12,0,12,10"
                    Minimum="0" Maximum="100" StepFrequency="0.25"
                    ValueChanged="OnSeekChanged" />
        </Grid>
    </Grid>
</Window>
