<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Anibel.App.Playback.PlayerHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Anibel.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="MiniStroke" Color="#33FFFFFF" />
        <Style x:Key="MediaBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MediaSeek" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="StepFrequency" Value="0.25" />
            <Setter Property="RequestedTheme" Value="Dark" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Resources>

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Space" Invoked="OnSpaceAccel" />
        <KeyboardAccelerator Key="F" Invoked="OnFullscreenAccel" />
        <KeyboardAccelerator Key="M" Invoked="OnMuteAccel" />
        <KeyboardAccelerator Key="Left" Invoked="OnSeekBackAccel" />
        <KeyboardAccelerator Key="Right" Invoked="OnSeekFwdAccel" />
    </UserControl.KeyboardAccelerators>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="ModeGroup">
            <VisualState x:Name="Theater" />
            <VisualState x:Name="Mini">
                <VisualState.Setters>
                    <Setter Target="TopBar.Visibility" Value="Collapsed" />
                    <Setter Target="BottomBar.Visibility" Value="Collapsed" />
                    <Setter Target="MiniHover.Visibility" Value="Collapsed" />
                    <Setter Target="Chrome.CornerRadius" Value="12" />
                    <Setter Target="Chrome.BorderThickness" Value="1" />
                    <Setter Target="Chrome.BorderBrush" Value="{StaticResource MiniStroke}" />
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Pip">
                <VisualState.Setters>
                    <Setter Target="TopBar.Visibility" Value="Collapsed" />
                    <Setter Target="BottomBar.Visibility" Value="Collapsed" />
                    <Setter Target="MiniHover.Visibility" Value="Collapsed" />
                    <Setter Target="TopBar.IsHitTestVisible" Value="False" />
                    <Setter Target="BottomBar.IsHitTestVisible" Value="False" />
                    <Setter Target="MiniHover.IsHitTestVisible" Value="False" />
                    <Setter Target="Chrome.CornerRadius" Value="0" />
                    <Setter Target="Chrome.BorderThickness" Value="0" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border x:Name="Chrome" Background="#000000" CornerRadius="0" BorderThickness="0">
        <Grid x:Name="ContentRoot"
              Background="Black"
              PointerEntered="OnPointerEntered"
              PointerMoved="OnPointerMoved"
              PointerExited="OnPointerExited"
              Tapped="OnSurfaceTapped"
              DoubleTapped="OnSurfaceDoubleTapped">
            <SwapChainPanel x:Name="VideoPanel"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            SizeChanged="OnSurfaceSizeChanged" />

            <StackPanel x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" MaxWidth="720" IsHitTestVisible="False">
                <TextBlock x:Name="StatusText" Foreground="#CCFFFFFF" TextAlignment="Center"
                           TextWrapping="Wrap" FontSize="14" />
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="44" Height="44"
                              Foreground="White" />
            </StackPanel>
            <Grid x:Name="ErrorHost" Visibility="Collapsed" RequestedTheme="Dark">
                <views:EmptyState x:Name="ErrorState"
                                  Title="Прабачце!"
                                  Glyph="&#xE7BA;"
                                  ActionText="Паўтарыць"
                                  SecondaryText="Капіяваць"
                                  ActionClick="OnRetryErrorClick"
                                  SecondaryClick="OnCopyErrorClick" />
            </Grid>

            <!-- Top overlay: title + window actions -->
            <Grid x:Name="TopBar" VerticalAlignment="Top" Padding="12,10,12,28" ColumnSpacing="8">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource MediaBtn}" Click="OnCollapseClick"
                        ToolTipService.ToolTip="Выплыўное акно">
                    <FontIcon Glyph="&#xE89F;" FontSize="16" Foreground="White" />
                </Button>
                <TextBlock x:Name="TitleText" Grid.Column="1" Foreground="White" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Style="{StaticResource MediaBtn}" Click="OnFullscreenClick"
                        ToolTipService.ToolTip="На ўвесь экран">
                    <SymbolIcon x:Name="FullscreenIcon" Symbol="FullScreen" Foreground="White" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource MediaBtn}" Click="OnCloseClick"
                        ToolTipService.ToolTip="Закрыць">
                    <SymbolIcon Symbol="Cancel" Foreground="White" />
                </Button>
            </Grid>

            <!-- Bottom overlay: seek + transport, YouTube-style -->
            <Grid x:Name="BottomBar" VerticalAlignment="Bottom" Padding="16,32,16,12" RowSpacing="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#E6000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Slider x:Name="SeekSlider" Style="{StaticResource MediaSeek}"
                        Maximum="100" IsEnabled="False" ValueChanged="OnSeekValueChanged" />
                <Grid Grid.Row="1" ColumnSpacing="4" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource MediaBtn}"
                            Click="OnPlayPauseClick" IsEnabled="False"
                            ToolTipService.ToolTip="Прайграць / паўза">
                        <SymbolIcon x:Name="PlayPauseIcon" Symbol="Pause" Foreground="White" />
                    </Button>
                    <Button Grid.Column="1" x:Name="SeekBackButton" Style="{StaticResource MediaBtn}"
                            Click="OnSeekBackClick" IsEnabled="False" ToolTipService.ToolTip="−10 с">
                        <FontIcon Glyph="&#xE892;" FontSize="16" Foreground="White" />
                    </Button>
                    <Button Grid.Column="2" x:Name="SeekForwardButton" Style="{StaticResource MediaBtn}"
                            Click="OnSeekForwardClick" IsEnabled="False" ToolTipService.ToolTip="+10 с">
                        <FontIcon Glyph="&#xE893;" FontSize="16" Foreground="White" />
                    </Button>
                    <TextBlock Grid.Column="3" x:Name="PositionText" Foreground="#EEFFFFFF"
                               VerticalAlignment="Center" Margin="8,0,12,0" FontSize="13"
                               Text="0:00 / 0:00" />
                    <Button Grid.Column="5" x:Name="MuteButton" Style="{StaticResource MediaBtn}"
                            Click="OnMuteClick" ToolTipService.ToolTip="Гук">
                        <SymbolIcon x:Name="VolumeIcon" Symbol="Volume" Foreground="White" />
                    </Button>
                    <Slider Grid.Column="6" x:Name="VolumeSlider" Width="92" Minimum="0" Maximum="100"
                            Value="100" Style="{StaticResource MediaSeek}" Margin="0,0,8,0"
                            ValueChanged="OnVolumeChanged" />
                    <Button Grid.Column="7" Style="{StaticResource MediaBtn}" Click="OnFullscreenClick"
                            ToolTipService.ToolTip="На ўвесь экран">
                        <SymbolIcon x:Name="FullscreenIconBottom" Symbol="FullScreen" Foreground="White" />
                    </Button>
                </Grid>
            </Grid>

            <Grid x:Name="MiniHover" Background="#66000000" Visibility="Collapsed">
                <Button HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="OnPlayPauseClick" Background="#CC111111" BorderThickness="0"
                        Width="52" Height="52" CornerRadius="26">
                    <SymbolIcon x:Name="MiniPlayIcon" Symbol="Pause" Foreground="White" />
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="8" Spacing="4">
                    <Button Click="OnExpandClick" ToolTipService.ToolTip="Разгарнуць"
                            Background="#CC111111" BorderThickness="0" Width="32" Height="32" CornerRadius="16">
                        <SymbolIcon Symbol="FullScreen" Foreground="White" />
                    </Button>
                    <Button Click="OnCloseClick" ToolTipService.ToolTip="Закрыць"
                            Background="#CC111111" BorderThickness="0" Width="32" Height="32" CornerRadius="16">
                        <SymbolIcon Symbol="Cancel" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
